# --- Tooling anidado (solo placeholder en este repo) ------------------------
# Ignorar TODO el árbol ci/. ci/.gitkeep ya está en el índice; así no reaparecen
# archivos nuevos del tooling (ni re-includes de su propio .gitignore).
ci/

# Symlinks / carpetas locales de desarrollo
# .cursor → ci/.cursor (memoria agente vive en el repo ci, no acá)
/bin
/docker
/tests
/.cursor
/.vscode

# --- Dependencias si alguien corre composer en la raíz ----------------------
/vendor/
/composer.json
/composer.lock
/phpunit.xml.dist
/phpcs.xml.dist
/phpstan.neon.dist

# --- Secretos (raíz del producto) -------------------------------------------
.env
.env.*
!.env.example
.env-backup
*.pem
*.key

